rules_version = '2';

// Anyone can read the skills shown on the public CV.
// Only YOUR account can add, edit or delete them.
// After your first login, the admin page shows your UID at the bottom —
// paste it below in place of PASTE_YOUR_UID_HERE, then publish these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /skills/{skillId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'PASTE_YOUR_UID_HERE';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
